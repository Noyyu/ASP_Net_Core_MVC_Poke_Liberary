@model IEnumerable<PokemonListItem>
@{
    ViewData["Title"] = "Pokémon list - Index";
}

<div class="pokemon-wrapper">
    <h1 class="pokemon-introduktion">Pokemon List</h1>
        <form class="search-wrapper" asp-controller="pokemon" asp-action="Search" method="get">
            <input type="search" name="search" class="textarea" placeholder="Search Pokemon..."></input>
            <button type="submit" class="button">Search</button>

        </form>
    <div class="pokemon-grid"> <partial name="_PokemonCardList" model="Model"> </div>
    <div id="scroll-trigger" style="height: 20px;"></div>
</div>
<script>
    let offset = 20; // Vi antar att du laddade 20 från början
    const trigger = document.getElementById('scroll-trigger');
    const grid = document.getElementById('pokemon-grid');

    const observer = new IntersectionObserver(async (entries) => {
        // Om triggern syns på skärmen
        if (entries[0].isIntersecting) {

            // Hämta HTML från din LoadMore-action
            const response = await fetch(`/Pokemon/LoadMore?offset=${offset}`);

            if (response.ok) {
                const html = await response.text();

                // Stoppa in de nya korten i botten av listan
                grid.insertAdjacentHTML('beforeend', html);

                // Öka offseten inför nästa laddning
                offset += 20;
            }
        }
    });

    // Starta övervakningen
    observer.observe(trigger);
</script>


