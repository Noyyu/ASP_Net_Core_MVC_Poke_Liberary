@model IEnumerable<PokemonListItem>
@{
    ViewData["Title"] = "Pokémon list - Index";
}

<div class="pokemon-wrapper">
    <h1 class="pokemon-introduktion">Pokemon List</h1>
        <form class="search-wrapper" asp-controller="pokemon" asp-action="Search" method="get">
            <input type="search" name="search" class="textarea" placeholder="Search Pokemon..."></input>
            <button type="submit" class="button">Search</button>

        </form>
    <div id="pokemon-grid" class="pokemon-grid"> <partial name="_PokemonCardList" model="Model"> </div>
    <div id="scroll-trigger" style="height: 20px;"></div>
</div>


<script>
    let offset = 151;
    const trigger = document.getElementById('scroll-trigger');
    const grid = document.getElementById('pokemon-grid');

    //Gets the type colors
    async function loadColors() {
        // Gets the cards that does nto have a color
        const cards = document.querySelectorAll('.pokemon-card:not(.color-loaded)');

        for (const card of cards) {
            card.classList.add('color-loaded'); // Make sure not to load it twice
            const id = card.getAttribute('data-id');

            // Get the type from the API
            const response = await fetch(`https://pokeapi.co/api/v2/pokemon/${id}`);
            if (response.ok) {
                const data = await response.json();
                const mainType = data.types[0].type.name; // Gets the primary type
                card.classList.add(`type-${mainType}`); // Adds the color by type (Its in the CSS file)
            }
        }
    }

    // Runs the funktion for the first 151 cards. 
    loadColors();

    const observer = new IntersectionObserver(async (entries) => {
        if (entries[0].isIntersecting) {

            if (window.location.search.includes('search=')) return;
            const response = await fetch(`/Pokemon/LoadMore?offset=${offset}`);

            if (response.ok) {
                const html = await response.text();
                grid.insertAdjacentHTML('beforeend', html);
                offset += 20;

                // Run it again for the newwly loaded cards
                loadColors();
            }
        }
    });

    observer.observe(trigger);
</script>


